# AI model gateway (OpenAI-compatible chat/completions with tool calling). Server-side only.
LLM_BASE_URL="https://your-gateway.example/v1"
LLM_API_KEY="replace-me"
LLM_MODEL="antigravity/gemini-3.8-flash-tiered"
LLM_FALLBACK_MODEL="auto/best-fast"
# Optional HTTP proxy for model calls ("off" to disable)
LLM_PROXY="off"
# Unclaimed shops auto-answer buyer questions after N seconds, clearly marked as demo (0 = off)
DEMO_SELLER_REPLY_SECONDS="20"
# Public domain for Caddy HTTPS (docker-compose)
DOMAIN="torobjoo.example.com"
